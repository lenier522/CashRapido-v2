<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- En release el lanzador son exclusivamente los activity-alias del
         manifest principal: MainActivity no declara MAIN/LAUNCHER, asi que no
         hay nada que eliminar aqui y nunca aparece un icono duplicado.

         Consecuencia: flutter run -release elige el primer alias habilitado
         del manifest (LauncherDefault) de forma estatica. Si en el dispositivo
         hay otro icono activo, ese alias esta deshabilitado y el lanzamiento
         automatico falla; para release usa:

             flutter build apk -release
             adb install build/app/outputs/flutter-apk/app-release.apk

         y abre la app desde su icono. flutter run en debug/profile si
         funciona siempre porque esos manifests convierten a MainActivity en el
         lanzador y eliminan los aliases. -->
</manifest>
