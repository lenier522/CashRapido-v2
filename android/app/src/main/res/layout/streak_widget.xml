<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/streak_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Flame Icon + Streak Count + Title + Target Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Flame Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_flame"
            android:contentDescription="Racha" />

        <!-- Streak Count Number -->
        <TextView
            android:id="@+id/streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0"
            android:textColor="#FF9600"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍAS DE RACHA"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/streak_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Racha activa hoy!"
                android:textColor="#FFA726"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Target / Reward Pill -->
        <TextView
            android:id="@+id/streak_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 0/50"
            android:textColor="#FFD54F"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2010"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <!-- 7-Day Tracker Bitmap -->
    <ImageView
        android:id="@+id/streak_week_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

    <!-- Motivational Footer -->
    <TextView
        android:id="@+id/streak_motivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="¡Mantén encendido tu hábito diario!"
        android:textColor="#9E9E9E"
        android:textSize="9sp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
